    "@fontsource/geist-sans": "^5.2.5",
    "@phosphor-icons/react": "^2.1.10",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "motion": "^13.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.6",
    "zustand": "^5.0.15"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Lucio73-collab/yoink.git"
  }
