{
  "name": "yoink",
  "version": "1.1.0",
  "description": "A fast, good-looking downloader for video and audio from anywhere yt-dlp reaches.",
  "main": "./out/main/index.js",
  "author": "Lucio73",
  "license": "GPL-3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/ensure-electron.mjs",
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "pack": "npm run build && electron-builder --dir --publish never",
    "dist": "npm run build && electron-builder --win --publish never",
    "lint": "node --check src/main/index.js"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.5",
